: ${R_HOME=`R RHOME`}
if test -z "${R_HOME}"; then
  echo "could not determine R_HOME"
  exit 1
fi

# Check whether R has been built with OpenMP support. If it has not, tell CMake
# to disable it rather than have salalib link something R cannot provide.
R_HAS_OMP=`"${R_HOME}/bin/Rscript.exe" -e 'mk <- readLines(file.path(R.home("etc"), .Platform[["r_arch"]], "Makeconf")); ln <- grep("^SHLIB_OPENMP_CXXFLAGS", mk, value = TRUE); cat(length(ln) == 1L && trimws(sub("^[^=]*=", "", ln)) == "-fopenmp")'`

DISABLE_OPENMP=OFF
if test "$R_HAS_OMP" = "FALSE" ; then
  echo "R has NOT been built with OpenMP support, disabling"
  DISABLE_OPENMP=ON
else
  echo "R has been built with OpenMP support, enabling"
fi

"${R_HOME}/bin/Rscript.exe" -e 'library(Rcpp); compileAttributes(".")'

cd src
mkdir -p build-Release && cd build-Release
cmake.exe ../libs \
  -DCMAKE_VERBOSE_MAKEFILE=ON \
  -DCMAKE_BUILD_TYPE=Release \
  -DBUILD_SHARED_LIBS:bool=OFF \
  -DCMAKE_POSITION_INDEPENDENT_CODE:bool=ON \
  -DDISABLE_OPENMP=${DISABLE_OPENMP}

# remove .NOTPARALLEL to stop CMD Check from complaining
find . -name Makefile -exec sed -i '/^.NOTPARALLEL:$/s/^/#/' {} \;

cmake.exe --build . --config Release
